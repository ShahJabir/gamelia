# ==============================================================================
# Gamelia Environment Variables Example
# Duplicate this file as `.env` and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Clerk Authentication (https://clerk.com)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------------------------
# Neon Database (Postgres) (https://neon.tech)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-your-pooled-host.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-your-direct-host.neon.tech/neondb?sslmode=require"
NEON_BRANCH=main

# ------------------------------------------------------------------------------
# AI Model Providers
# ------------------------------------------------------------------------------
# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key

# ------------------------------------------------------------------------------
# Trigger.dev Background Tasks (https://cloud.trigger.dev)
# ------------------------------------------------------------------------------
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret_key

# ------------------------------------------------------------------------------
# Daytona Cloud Sandboxes (https://app.daytona.io/dashboard/keys)
# ------------------------------------------------------------------------------
DAYTONA_API_KEY=dtn_your_daytona_api_key

# ------------------------------------------------------------------------------
# Firecrawl Web Scraping (https://firecrawl.dev)
# ------------------------------------------------------------------------------
FIRECRAWL_API_KEY=fc_your_firecrawl_api_key
